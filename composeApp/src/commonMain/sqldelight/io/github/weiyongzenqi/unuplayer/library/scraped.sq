-- 海报墙刮削库索引表(同 UnuDatabase, 与 PlaybackRecord 同库共享 driver/WAL)
-- 设计见 .claude/plans/poster-wall.md §2
--
-- 四张表:
--   ScrapedLibrary  刮削库源配置(本地 SAF / WebDAV), 一个配置一行
--   ScrapedShow     番剧(一个含 tvshow.nfo 的文件夹一行), 主键 tmdb_id
--   ScrapedSeason   季(一个 Season N 文件夹一行), release_date 为季度分组依据, bangumi_id 可空
--   ScrapedEpisode  剧集(一个 mkv+nfo 一行), media_key 关联 PlaybackRecord 播放进度
--
-- 外键级联: 删 Library -> Show -> Season -> Episode; 删 Show -> Season -> Episode。
--   依赖 PRAGMA foreign_keys=ON(见 UnuDatabaseProvider.UnuSqliteCallback.onOpen)。
-- WAL: 见 UnuDatabaseProvider(wal_autocheckpoint=500 + 扫描后 TRUNCATE)。

-- === 刮削库源配置 ===
CREATE TABLE ScrapedLibrary (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,                      -- 用户起的名
    source_kind TEXT NOT NULL,               -- WEBDAV / LOCAL
    connection_id TEXT,                      -- WEBDAV: WebDavConnection.id; LOCAL: null
    local_uri TEXT,                          -- LOCAL: SAF tree uri; WEBDAV: null
    root_path TEXT NOT NULL,                 -- 刮削库根路径(WEBDAV=mount-relative; LOCAL=tree uri 或子目录 uri)
    scan_depth INTEGER NOT NULL DEFAULT 6,   -- 最大递归深度
    scan_mode TEXT NOT NULL DEFAULT 'NFO',   -- 扫描模式: NFO(tvshow.nfo 刮削) / ANCHOR(本地锚点封面+文件夹名)
    anchor_filename TEXT,                    -- ANCHOR 锚点封面候选(逗号分隔, 如 folder.jpg,poster.jpg); NFO=null
    last_scanned_at INTEGER,                 -- 上次扫描完成时间戳; null=从未扫描
    created_at INTEGER NOT NULL
);

-- === 番剧 ===
CREATE TABLE ScrapedShow (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    library_id INTEGER NOT NULL,
    source_kind TEXT NOT NULL,               -- 冗余: 图片加载/播放重建 MediaSource 分支用
    tmdb_id INTEGER,                         -- tvshow.nfo tmdbid(一般有, 兜底可空)
    folder_name TEXT NOT NULL,               -- 番剧文件夹名(含 {tmdb-xxx})
    show_path TEXT NOT NULL,                 -- 番剧文件夹路径(幂等键)
    title TEXT NOT NULL,                     -- tvshow.nfo title <- 对外显示名
    original_title TEXT,                     -- tvshow.nfo originaltitle
    year INTEGER,
    plot TEXT,
    rating REAL,
    release_date TEXT,                       -- tvshow.nfo releasedate(番剧首播)
    genres TEXT,                             -- 逗号分隔
    studios TEXT,                            -- 逗号分隔
    poster_path TEXT,
    fanart_path TEXT,
    clearlogo_path TEXT,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    favorited_at INTEGER,                          -- null=未收藏
    favorite_sort_order INTEGER NOT NULL DEFAULT 0,-- 二期手动排序预留
    is_hidden INTEGER NOT NULL DEFAULT 0,
    scanned_at INTEGER NOT NULL,
    UNIQUE(library_id, show_path),
    FOREIGN KEY(library_id) REFERENCES ScrapedLibrary(id) ON DELETE CASCADE
);
CREATE INDEX idx_show_library ON ScrapedShow(library_id);
CREATE INDEX idx_show_tmdb ON ScrapedShow(tmdb_id);

-- === 季 ===
CREATE TABLE ScrapedSeason (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    show_id INTEGER NOT NULL,
    season_number INTEGER NOT NULL,
    season_path TEXT NOT NULL,
    title TEXT,                              -- "第 1 季"
    year INTEGER,
    release_date TEXT,                       -- season.nfo releasedate <- 季度分组主依据
    bangumi_id INTEGER,                      -- bangumi.ini id (可空! 文件不存在则 null)
    bangumi_offset INTEGER NOT NULL DEFAULT 0,
    season_poster_path TEXT,                 -- seasonXX-poster.jpg
    episode_count INTEGER NOT NULL DEFAULT 0,
    scanned_at INTEGER NOT NULL,
    UNIQUE(show_id, season_number),
    FOREIGN KEY(show_id) REFERENCES ScrapedShow(id) ON DELETE CASCADE
);
CREATE INDEX idx_season_show ON ScrapedSeason(show_id);
CREATE INDEX idx_season_bangumi ON ScrapedSeason(bangumi_id);
CREATE INDEX idx_season_release ON ScrapedSeason(release_date);

-- === 剧集 ===
CREATE TABLE ScrapedEpisode (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    season_id INTEGER NOT NULL,
    show_id INTEGER NOT NULL,                -- 冗余: 便于直接查番剧所有集
    episode_number INTEGER NOT NULL,
    title TEXT,                              -- 单集 .nfo title
    plot TEXT,
    aired TEXT,
    year INTEGER,
    runtime INTEGER,
    rating REAL,
    video_path TEXT NOT NULL,                -- .mkv 路径(播放用)
    video_name TEXT NOT NULL,
    thumb_path TEXT,                         -- xxx-thumb.jpg
    local_thumb_path TEXT,                   -- 本地生成集照绝对路径(thumb_path 为空时本地抽帧生成, PosterCache 内)
    media_key TEXT,                          -- 关联 PlaybackRecord(WebDAV=webdav key, LOCAL=local key)
    file_size INTEGER,
    scanned_at INTEGER NOT NULL,
    UNIQUE(season_id, episode_number),
    FOREIGN KEY(season_id) REFERENCES ScrapedSeason(id) ON DELETE CASCADE,
    FOREIGN KEY(show_id) REFERENCES ScrapedShow(id) ON DELETE CASCADE
);
CREATE INDEX idx_episode_season ON ScrapedEpisode(season_id);
CREATE INDEX idx_episode_show ON ScrapedEpisode(show_id, episode_number);
CREATE INDEX idx_episode_media_key ON ScrapedEpisode(media_key);

-- === 屏蔽(独立于 Show: 删 Show 记录后屏蔽意图仍留存, 防 scanner 重扫回来) ===
CREATE TABLE ScrapedBlocked (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    library_id INTEGER NOT NULL,
    show_path TEXT NOT NULL,          -- 幂等键, scanner 据此跳过
    title TEXT,                       -- 展示用(删 Show 后留名)
    tmdb_id INTEGER,
    blocked_at INTEGER NOT NULL,
    UNIQUE(library_id, show_path),
    FOREIGN KEY(library_id) REFERENCES ScrapedLibrary(id) ON DELETE CASCADE
);
CREATE INDEX idx_blocked_library ON ScrapedBlocked(library_id);

-- ============ Library CRUD ============

insertLibrary:
INSERT INTO ScrapedLibrary(name, source_kind, connection_id, local_uri, root_path, scan_depth, scan_mode, anchor_filename, created_at)
VALUES (:name, :source_kind, :connection_id, :local_uri, :root_path, :scan_depth, :scan_mode, :anchor_filename, :created_at);

listLibraries:
SELECT * FROM ScrapedLibrary ORDER BY created_at ASC;

getLibrary:
SELECT * FROM ScrapedLibrary WHERE id = :id;

deleteLibrary:
DELETE FROM ScrapedLibrary WHERE id = :id;

updateLibraryLastScanned:
UPDATE ScrapedLibrary SET last_scanned_at = :last_scanned_at WHERE id = :id;

updateLibraryRootPath:
UPDATE ScrapedLibrary SET root_path = :root_path, scan_depth = :scan_depth WHERE id = :id;

-- 编辑刮削库: name + root_path + scan_depth(source_kind/connection/local_uri 不可改, 改了关联数据不匹配)
updateLibraryMeta:
UPDATE ScrapedLibrary SET name = :name, root_path = :root_path, scan_depth = :scan_depth WHERE id = :id;

-- ============ Show ============

insertShow:
INSERT INTO ScrapedShow(
    library_id, source_kind, tmdb_id, folder_name, show_path, title, original_title,
    year, plot, rating, release_date, genres, studios, poster_path, fanart_path, clearlogo_path, scanned_at
) VALUES (
    :library_id, :source_kind, :tmdb_id, :folder_name, :show_path, :title, :original_title,
    :year, :plot, :rating, :release_date, :genres, :studios, :poster_path, :fanart_path, :clearlogo_path, :scanned_at
);

-- 命中查询(扫描幂等用)
getShowByPath:
SELECT * FROM ScrapedShow WHERE library_id = :library_id AND show_path = :show_path LIMIT 1;

getShowById:
SELECT * FROM ScrapedShow WHERE id = :id;

-- 取最近 INSERT 的自增 id(addLibrary/addShow/addSeason 返回 id 用)
lastInsertRowId:
SELECT last_insert_rowid();

-- 刷新已存在番剧元数据(upsertShow 命中现有 show 时, 保留 id 更新元数据, 子表单独删重插)
updateShow:
UPDATE ScrapedShow SET
    tmdb_id = :tmdb_id, folder_name = :folder_name, title = :title, original_title = :original_title,
    year = :year, plot = :plot, rating = :rating, release_date = :release_date,
    genres = :genres, studios = :studios, poster_path = :poster_path, fanart_path = :fanart_path, clearlogo_path = :clearlogo_path, scanned_at = :scanned_at
WHERE id = :id;

-- 海报墙列表(季度排序, 默认): 过滤屏蔽+隐藏, 收藏置顶(收藏内按 favorited_at DESC)
-- 注意: SQLite API26 不支持 NULLS LAST, 用 (xx IS NULL) ASC 把空排末尾。
-- P3㉒: MIN(release_date) 子查询原对全表 ScrapedSeason 聚合(扫所有库的季), 现经
--   ScrapedShow.library_id 关联收窄到本库的季。语义不变: 一个 show 只属于一个库,
--   其所有季同库, 每 show 的 MIN 值不受影响; 仅减少跨库无效聚合(多库场景走 idx_show_library + idx_season_show)。
-- 批次C 新增三列(六个 card 查询同构):
--   card_online_fanart_path: 部级(season_number=0)在线头图本地路径, 无则 NULL
--     (PosterCard 无任何封面时的模糊兜底背景);
--   card_remote_poster_url / card_remote_poster_season: 最新「有远程 URL 且无本地文件」的
--     季级海报 URL 与同行的季号(海报墙一次性在线补封通道定位用; 最新季已有本地文件时
--     该季被跳过, 取更早的缺文件季, 与 card_poster_path 的取图优先级不冲突)。
--     season 列用 NULLIF(x, -1) 包裹仅为让 SQLDelight 推断可空(WHERE season_number > 0 保证
--     永不实际命中 -1): 子查询无匹配行时该列是 NULL, 裸选 NOT NULL 列会生成 !! 断言在运行时 NPE。
-- 性能边界: pm 必须关联当前 s 行后用主键前缀求 MAX(season_number), 禁止先按全表
-- (library_id, show_path) GROUP BY 再物化派生表；海报墙只取少量行时后者会扫描全部在线 meta。
listShowsByLibrary:
SELECT s.*, mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number
FROM ScrapedShow s
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se
    INNER JOIN ScrapedShow sh ON sh.id = se.show_id
    WHERE sh.library_id = :library_id
    GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE s.library_id = :library_id
  AND s.is_hidden = 0
  AND b.id IS NULL
ORDER BY s.is_favorite DESC,
         (CASE WHEN s.is_favorite = 1 THEN s.favorited_at ELSE 0 END) DESC,
         (min_release_date IS NULL) ASC, min_release_date DESC, s.title ASC;

listShowsByLibraryYear:
SELECT s.*, mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number
FROM ScrapedShow s
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se
    INNER JOIN ScrapedShow sh ON sh.id = se.show_id
    WHERE sh.library_id = :library_id
    GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE s.library_id = :library_id
  AND s.is_hidden = 0
  AND b.id IS NULL
ORDER BY s.is_favorite DESC,
         (CASE WHEN s.is_favorite = 1 THEN s.favorited_at ELSE 0 END) DESC,
         (s.year IS NULL) ASC, s.year DESC, s.title ASC;

listShowsByLibraryRecent:
SELECT s.*, mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number
FROM ScrapedShow s
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se
    INNER JOIN ScrapedShow sh ON sh.id = se.show_id
    WHERE sh.library_id = :library_id
    GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE s.library_id = :library_id
  AND s.is_hidden = 0
  AND b.id IS NULL
ORDER BY s.is_favorite DESC,
         (CASE WHEN s.is_favorite = 1 THEN s.favorited_at ELSE 0 END) DESC,
         s.scanned_at DESC, s.title ASC;

-- 隐藏段(顶部下拉显示用): is_hidden=1, 未屏蔽
listHiddenShowsByLibrary:
SELECT s.*, mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number
FROM ScrapedShow s
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se
    INNER JOIN ScrapedShow sh ON sh.id = se.show_id
    WHERE sh.library_id = :library_id
    GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE s.library_id = :library_id
  AND s.is_hidden = 1
  AND b.id IS NULL
ORDER BY s.is_favorite DESC, s.title ASC;

-- 单季季度的番剧列表(按指定季 release_date 取该季番剧, 时间表/季度视图用)
-- P3㉒: substr(release_date,1,7) 包列函数使 idx_season_release 失效退化为全表扫描, 改为字典序范围查询走索引。
-- 边界语义: [yearMonthStart, nextMonthStart) 是 "YYYY-MM" 前缀范围(两端均不含 "-01" 日), 与原
--   substr(release_date,1,7)=yearMonth 精确等价——"YYYY-MM-DD" 与不足长度的 "YYYY-MM" 短格式都命中。
--   (若边界加 "-01", 则 "YYYY-MM" 短格式 < "YYYY-MM-01" 被漏掉, 行为与现状不一致, 故不加。)
-- Kotlin 侧调用方计算: yearMonthStart = "YYYY-MM"; nextMonthStart = 下月的 "YYYY-MM"
--   (跨年: "YYYY-12" -> "(YYYY+1)-01", 月补零)。release_date 为 NULL 的季不命中(与现状一致)。
listShowsBySeasonRelease:
SELECT s.* FROM ScrapedShow s
WHERE s.id IN (
    SELECT se.show_id FROM ScrapedSeason se
    WHERE se.release_date >= :yearMonthStart AND se.release_date < :nextMonthStart
)
ORDER BY s.title ASC;

-- 搜索番剧(全局/当前库): title LIKE, 过滤屏蔽+隐藏; library_id=null 全局, 非 null 限当前库
-- P3㉒: 同 listShowsByLibrary 的子查询收窄; library_id 可空(全局搜索), NULL 时不过滤=全库聚合(与原语义一致)。
listShowsSearch:
SELECT s.*, mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number
FROM ScrapedShow s
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se
    INNER JOIN ScrapedShow sh ON sh.id = se.show_id
    WHERE (:library_id IS NULL OR sh.library_id = :library_id)
    GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE s.is_hidden = 0
  AND b.id IS NULL
  AND (:library_id IS NULL OR s.library_id = :library_id)
  AND s.title LIKE :keyword ESCAPE '\'
ORDER BY s.title ASC;

deleteShow:
DELETE FROM ScrapedShow WHERE id = :id;

deleteShowsByLibrary:
DELETE FROM ScrapedShow WHERE library_id = :library_id;

-- 增量重扫: 列某库已记录的 show_path(对比实际子目录, 找未记录的)
listShowPathsByLibrary:
SELECT show_path FROM ScrapedShow WHERE library_id = :library_id;

-- ============ Season ============

insertSeason:
INSERT INTO ScrapedSeason(
    show_id, season_number, season_path, title, year, release_date,
    bangumi_id, bangumi_offset, season_poster_path, episode_count, scanned_at
) VALUES (
    :show_id, :season_number, :season_path, :title, :year, :release_date,
    :bangumi_id, :bangumi_offset, :season_poster_path, :episode_count, :scanned_at
);

listSeasonsByShow:
SELECT * FROM ScrapedSeason WHERE show_id = :show_id ORDER BY season_number ASC;

-- 同 tmdbid 跨文件夹检索所有季(详情页横向季切换用): 同库内所有该 tmdbid 番剧的季,
-- 按 season_number 升序。tmdb_id 为 NULL 的番剧(ANCHOR)不命中(调用方回落 listSeasons)。
listSeasonsByTmdb:
SELECT se.* FROM ScrapedSeason se
INNER JOIN ScrapedShow sh ON sh.id = se.show_id
WHERE sh.library_id = :library_id AND sh.tmdb_id = :tmdb_id
ORDER BY se.season_number ASC;

getSeason:
SELECT * FROM ScrapedSeason WHERE show_id = :show_id AND season_number = :season_number LIMIT 1;

deleteSeasonsByShow:
DELETE FROM ScrapedSeason WHERE show_id = :show_id;

deleteSeasonByShowAndNumber:
DELETE FROM ScrapedSeason WHERE show_id = :show_id AND season_number = :season_number;

-- ============ Episode ============

insertEpisode:
INSERT INTO ScrapedEpisode(
    season_id, show_id, episode_number, title, plot, aired, year, runtime, rating,
    video_path, video_name, thumb_path, local_thumb_path, media_key, file_size, scanned_at
) VALUES (
    :season_id, :show_id, :episode_number, :title, :plot, :aired, :year, :runtime, :rating,
    :video_path, :video_name, :thumb_path, :local_thumb_path, :media_key, :file_size, :scanned_at
);

listEpisodesBySeason:
SELECT * FROM ScrapedEpisode WHERE season_id = :season_id ORDER BY episode_number ASC;

-- 批量查剧集(详情页剧集进度披露式查询用): IN 批量(调用方分块 ≤500)
getEpisodesByMediaKeys:
SELECT * FROM ScrapedEpisode WHERE media_key IN :media_keys;

deleteEpisodesBySeason:
DELETE FROM ScrapedEpisode WHERE season_id = :season_id;

-- 更新某集本地生成集照路径(详情页抽帧成功后回写)
updateEpisodeLocalThumb:
UPDATE ScrapedEpisode SET local_thumb_path = :path WHERE id = :id;

-- ============ Show 用户状态(收藏/隐藏/屏蔽) ============

setFavorite:
UPDATE ScrapedShow SET is_favorite = :is_favorite, favorited_at = :favorited_at WHERE id = :id;

setHidden:
UPDATE ScrapedShow SET is_hidden = :is_hidden WHERE id = :id;

insertBlocked:
INSERT OR IGNORE INTO ScrapedBlocked(library_id, show_path, title, tmdb_id, blocked_at)
VALUES (:library_id, :show_path, :title, :tmdb_id, :blocked_at);

deleteBlocked:
DELETE FROM ScrapedBlocked WHERE id = :id;

listBlockedByLibrary:
SELECT * FROM ScrapedBlocked WHERE library_id = :library_id ORDER BY blocked_at DESC;

isBlocked:
SELECT EXISTS(SELECT 1 FROM ScrapedBlocked WHERE library_id = :library_id AND show_path = :show_path);

-- ============ 统计 / 清理 ============

countShowsByLibrary:
SELECT COUNT(*) FROM ScrapedShow WHERE library_id = :library_id;

countEpisodesByLibrary:
SELECT COUNT(*) FROM ScrapedEpisode
WHERE season_id IN (SELECT id FROM ScrapedSeason WHERE show_id IN (SELECT id FROM ScrapedShow WHERE library_id = :library_id));

-- 最近播放番剧(跨库混排): 按番剧聚合最近一次播放时间倒序。
-- PlaybackRecord JOIN ScrapedEpisode.media_key -> show_id, GROUP BY show_id 取 MAX(last_played_at)。
-- 复用 listShowsByLibrary 的 mn 子查询(min_release_date/card_season_number)与 card_poster_path 子查询、
-- ScrapedBlocked 过滤。library_id=null 全库混排, 非 null 限单库。含隐藏(仅过滤屏蔽)。
-- mx 子查询 INNER JOIN PlaybackRecord: 仅命中有播放记录的 episode, NULL media_key 不匹配(SQL NULL=NULL 为 false)。
-- P1b-B2: 按 tmdb_id 聚合(同番跨库只一行, 取 last_played_at 最大者), 无 tmdb_id(ANCHOR)回退 show_id。
listRecentlyPlayedShows:
SELECT s.id, s.library_id, s.source_kind, s.tmdb_id, s.folder_name, s.show_path,
       s.title, s.original_title, s.year, s.plot, s.rating, s.release_date,
       s.genres, s.studios, s.poster_path, s.fanart_path, s.clearlogo_path,
       s.is_favorite, s.favorited_at, s.favorite_sort_order, s.is_hidden, s.scanned_at,
       mn.min_release_date AS min_release_date,
       COALESCE(
           NULLIF(TRIM(s.poster_path), ''),
           (SELECT NULLIF(TRIM(se.season_poster_path), '') FROM ScrapedSeason se
            WHERE se.show_id = s.id AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
            ORDER BY se.season_number DESC LIMIT 1),
           (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
              AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
            ORDER BY m.season_number DESC LIMIT 1)
       ) AS card_poster_path,
       (SELECT NULLIF(TRIM(m.local_poster_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
          AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
        ORDER BY m.season_number DESC LIMIT 1) AS card_online_poster_path,
       (SELECT NULLIF(TRIM(m.local_fanart_path), '') FROM ScrapedOnlineMeta m
        WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
          AND NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
        LIMIT 1) AS card_online_fanart_path,
       pm.remote_poster_url AS card_remote_poster_url,
       NULLIF(pm.season_number, -1) AS card_remote_poster_season,
       CASE
           WHEN NULLIF(TRIM(s.poster_path), '') IS NOT NULL OR EXISTS(
               SELECT 1 FROM ScrapedSeason se WHERE se.show_id = s.id
                 AND NULLIF(TRIM(se.season_poster_path), '') IS NOT NULL
           ) THEN 'MEDIA_SOURCE'
           WHEN EXISTS(
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number > 0
                 AND NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
           ) THEN 'LOCAL_FILE'
           ELSE 'MEDIA_SOURCE'
       END AS card_poster_path_kind,
       mn.card_season_number AS card_season_number,
       mx.last_played_at AS last_played_at
FROM ScrapedShow s
INNER JOIN (
    -- tmdb_id 非空: 按 tmdb_id 聚合, 取 last_played_at 最大的 show
    SELECT
        sh.tmdb_id AS tid,
        (SELECT sh2.id FROM ScrapedShow sh2
         INNER JOIN ScrapedEpisode ep2 ON ep2.show_id = sh2.id
         INNER JOIN PlaybackRecord pr2 ON pr2.media_key = ep2.media_key
         WHERE sh2.tmdb_id = sh.tmdb_id
           AND (:library_id IS NULL OR sh2.library_id = :library_id)
         ORDER BY pr2.last_played_at DESC LIMIT 1) AS sid,
        MAX(pr.last_played_at) AS last_played_at
    FROM ScrapedEpisode ep
    INNER JOIN PlaybackRecord pr ON pr.media_key = ep.media_key
    INNER JOIN ScrapedShow sh ON sh.id = ep.show_id
    WHERE sh.tmdb_id IS NOT NULL
      AND (:library_id IS NULL OR sh.library_id = :library_id)
    GROUP BY sh.tmdb_id
    UNION ALL
    -- tmdb_id 为空(ANCHOR): 按 show_id 聚合
    SELECT NULL AS tid, sh.id AS sid, MAX(pr.last_played_at) AS last_played_at
    FROM ScrapedEpisode ep
    INNER JOIN PlaybackRecord pr ON pr.media_key = ep.media_key
    INNER JOIN ScrapedShow sh ON sh.id = ep.show_id
    WHERE sh.tmdb_id IS NULL
    GROUP BY sh.id
) mx ON s.id = mx.sid
LEFT JOIN (
    SELECT se.show_id, MIN(se.release_date) AS min_release_date,
           CASE WHEN COUNT(se.season_number) = 1 THEN MAX(se.season_number) ELSE NULL END AS card_season_number
    FROM ScrapedSeason se GROUP BY se.show_id
) mn ON mn.show_id = s.id
LEFT JOIN ScrapedOnlineMeta pm
  ON pm.library_id = s.library_id
 AND pm.show_path = s.show_path
 AND pm.season_number = (
    SELECT MAX(m.season_number)
    FROM ScrapedOnlineMeta m
    WHERE m.library_id = s.library_id
      AND m.show_path = s.show_path
      AND m.season_number > 0
      AND NULLIF(TRIM(m.remote_poster_url), '') IS NOT NULL
      AND (m.local_poster_path IS NULL OR TRIM(m.local_poster_path) = '')
 )
LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
WHERE b.id IS NULL
  AND (:library_id IS NULL OR s.library_id = :library_id)
ORDER BY mx.last_played_at DESC
LIMIT :limit;

-- 清空所有刮削数据(保留 Library 配置)。依赖外键级联删 Season/Episode。
deleteAllScrapedData:
DELETE FROM ScrapedShow;

-- ============ 本部专属设置覆盖(稀疏 JSON, 按 identity_key 存取) ============

CREATE TABLE ShowSettingsOverride (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    identity_key TEXT NOT NULL UNIQUE,   -- "tmdb:<id>"(刮削跨库) 或 "show:<libraryId>:<showPath>"(ANCHOR单库)
    overrides_json TEXT NOT NULL,        -- 稀疏覆盖 JSON(ShowOverrideSettings, 字段全可空, null=跟随全局)
    updated_at INTEGER NOT NULL
);

getShowOverrideJson:
SELECT overrides_json FROM ShowSettingsOverride WHERE identity_key = :identity_key LIMIT 1;

-- 完整覆盖行(在线刮削识别 tmdb_id 后把 show: 键迁移到 tmdb: 键用, 保留 updated_at)
getShowOverrideRow:
SELECT * FROM ShowSettingsOverride WHERE identity_key = :identity_key LIMIT 1;

-- INSERT OR REPLACE: 老 SQLite 无 ON CONFLICT upsert; UNIQUE(identity_key) 冲突即整行替换(新 rowid 无碍)
upsertShowOverride:
INSERT OR REPLACE INTO ShowSettingsOverride(identity_key, overrides_json, updated_at)
VALUES (:identity_key, :overrides_json, :updated_at);

deleteShowOverride:
DELETE FROM ShowSettingsOverride WHERE identity_key = :identity_key;

-- ============ Bangumi 季度关联(独立于扫描生命周期) ============

CREATE TABLE BangumiSeasonLinkEntity (
    identity_key TEXT NOT NULL PRIMARY KEY, -- tmdb-tv:<id>:season:<n> 或 show:<libraryId>:<showPath>:season:<n>
    bangumi_subject_id INTEGER,             -- DISABLED/CONFLICT 时可空
    state TEXT NOT NULL,                    -- CONFIRMED / DISABLED / CONFLICT
    source TEXT NOT NULL,                   -- MANUAL / EXT_LINKER / AUTO
    evidence TEXT,                          -- 仅保存脱敏来源摘要, 不保存响应正文
    updated_at INTEGER NOT NULL,
    verified_at INTEGER
);
CREATE INDEX idx_bangumi_season_subject ON BangumiSeasonLinkEntity(bangumi_subject_id);

getBangumiSeasonLink:
SELECT * FROM BangumiSeasonLinkEntity WHERE identity_key = :identity_key LIMIT 1;

upsertBangumiSeasonLink:
INSERT OR REPLACE INTO BangumiSeasonLinkEntity(
    identity_key, bangumi_subject_id, state, source, evidence, updated_at, verified_at
) VALUES (
    :identity_key, :bangumi_subject_id, :state, :source, :evidence, :updated_at, :verified_at
);

deleteBangumiSeasonLink:
DELETE FROM BangumiSeasonLinkEntity WHERE identity_key = :identity_key;

-- ============ 在线刮削 meta(独立于扫描生命周期, 见 .claude/plans/online-scraping-2026-08-06.md §5.2) ============
-- 设计要点:
--  - 持久 source of truth: 在线刮削(弹弹/Bangumi)结果写此表 + 回填现有显示表(show/season/episode),
--    扫描器 upsertShow 删季重插后经 reapplyOnlineMeta 把数据放回显示表, 防止重扫抹掉在线数据。
--  - 独立表而非给 ScrapedShow/Season/Episode 加列: upsertShow 删季重插会抹掉子表上的在线列;
--    此表不被打扫, reapply 负责同步。现有 SQL 查询零改动。
--  - 迁移零风险: 只新增一张表(CREATE TABLE IF NOT EXISTS 挂 UnuDatabaseProvider.ensureCurrentSchema), 不 ALTER 现有表。
--  - 高置信命中自动写 BangumiSeasonLinkEntity(工作树预载决策): 每季 hash 锚点/唯一候选/
--    Bangumi 唯一源写 source=AUTO, 手动纠正写 MANUAL; 不覆盖既有手动确认/禁用; 评论区立即可用。
--    每季 meta 同时记 dandanplay_id 与 bangumi_id 供重放定位。
--  - TMDB 增强: remote_fanart_url/local_fanart_path = 宽幅头图(部级, UI 在 NFO fanart 后回退);
--    episode_json[].thumbPath = 剧集剧照本地绝对路径(UI 在 NFO thumb 后回退)。
--    由 updateOnlineMetaFanart/updateOnlineMetaEpisodes 单独写; repository 先合并已有字段再主 upsert,
--    失败时保留远程 URL，后续刮削可重试。
--  - 生命周期: 仅用户手动删番剧(deleteShowAndBlock)/删库(deleteAllScrapedData)时删除; 重扫/清缓存不删。

CREATE TABLE ScrapedOnlineMeta (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    library_id INTEGER NOT NULL,
    show_path TEXT NOT NULL,                    -- 幂等键(与 ScrapedShow 同公式; 重放/纠错定位用)
    season_number INTEGER NOT NULL DEFAULT 0,   -- -1=立即重试标记; 0=部级; >0=季级
    scrape_source TEXT NOT NULL,                -- NFO / AUTO_ATTEMPT / DANDANPLAY / BANGUMI / TMDB / MANUAL_DANDANPLAY / MANUAL_BANGUMI / MANUAL_TMDB
    overwrite_title INTEGER NOT NULL DEFAULT 0, -- 1=可覆盖占位标题(ANCHOR 模式/手动刮削); 0=auto 只填空(NFO 真标题保留)
    tmdb_id INTEGER,                            -- TMDB 身份；ANCHOR 在线识别后持久化，重扫时回放到 ScrapedShow
    dandanplay_id INTEGER,                      -- 弹弹 animeId(季级身份; 重扫后按季号重放定位)
    bangumi_id INTEGER,                         -- bgm subjectId(部级/季级; 不写 BangumiSeasonLinkEntity)
    remote_poster_url TEXT,                     -- 远程季照 URL(弹弹 imageUrl / bgm images.large; 下载失败仅留此 URL 可重下)
    local_poster_path TEXT,                     -- 下载到 PosterCache 的绝对路径(UI 作为 NFO 季照后的 LOCAL_FILE 回退)
    poster_source TEXT,                         -- 海报对(remote/local)归属来源(与文本/身份来源 scrape_source 解耦);
                                                -- null=无海报对; 有对时记最后一次写入海报的来源, 供优先级比较防低源顶掉
    title TEXT, original_title TEXT, year INTEGER, plot TEXT, rating REAL,
    release_date TEXT, genres TEXT, studios TEXT,   -- 部级元数据(重放回 ScrapedShow; genres/studios 逗号分隔)
    episode_json TEXT,                          -- JSON: [{"episodeNumber":1,"title":"..","aired":"..","plot":"..","thumbPath":".."}] (季级集标题/放送日/简介/剧照)
    remote_fanart_url TEXT,                     -- TMDB 宽幅头图 backdrop URL(部级; 下载失败仅留 URL 可重下)
    local_fanart_path TEXT,                     -- TMDB 头图下载绝对路径(UI 作为 NFO fanart 后的 LOCAL_FILE 回退)
    scraped_at INTEGER NOT NULL,
    UNIQUE(library_id, show_path, season_number),
    FOREIGN KEY(library_id) REFERENCES ScrapedLibrary(id) ON DELETE CASCADE
);
CREATE INDEX idx_online_meta_show ON ScrapedOnlineMeta(library_id, show_path);

-- TMDB 自动身份匹配真实未命中状态。仅成功完成搜索但没有可接受候选时写入；
-- 网络失败、未配置令牌和未执行搜索均不得写入。prompt_suppressed 只关闭自动提示，
-- 不影响详情页手动 TMDB 搜索；成功取得 TMDB 身份或恢复 NFO 时删除。
CREATE TABLE TmdbAutoMatchFailure (
    library_id INTEGER NOT NULL,
    show_path TEXT NOT NULL,
    failed_at INTEGER NOT NULL,
    prompt_suppressed INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(library_id, show_path),
    FOREIGN KEY(library_id, show_path)
        REFERENCES ScrapedShow(library_id, show_path) ON DELETE CASCADE
);

getTmdbAutoMatchFailure:
SELECT * FROM TmdbAutoMatchFailure
WHERE library_id = :library_id AND show_path = :show_path
LIMIT 1;

insertTmdbAutoMatchFailure:
INSERT OR IGNORE INTO TmdbAutoMatchFailure(
    library_id, show_path, failed_at, prompt_suppressed
) VALUES (
    :library_id, :show_path, :failed_at, 0
);

updateTmdbAutoMatchFailureAt:
UPDATE TmdbAutoMatchFailure SET failed_at = :failed_at
WHERE library_id = :library_id AND show_path = :show_path;

suppressTmdbAutoMatchPrompt:
UPDATE TmdbAutoMatchFailure SET prompt_suppressed = 1
WHERE library_id = :library_id AND show_path = :show_path;

deleteTmdbAutoMatchFailure:
DELETE FROM TmdbAutoMatchFailure
WHERE library_id = :library_id AND show_path = :show_path;

deleteAllTmdbAutoMatchFailures:
DELETE FROM TmdbAutoMatchFailure;

-- ============ 自动刮削关闭(详情页横幅"永久关闭", 2026-08-14) ============
-- 仅抑制详情页进入时的自动刮削(autoScrapeMode), 手动刮削/候选弹窗/TMDB 提示/手动批量补刮不受影响。
-- 详情页菜单「重新开启自动刮削」删除本行即可恢复。

CREATE TABLE AutoScrapeSuppression (
    library_id INTEGER NOT NULL,
    show_path TEXT NOT NULL,
    suppressed_at INTEGER NOT NULL,
    PRIMARY KEY(library_id, show_path),
    FOREIGN KEY(library_id, show_path)
        REFERENCES ScrapedShow(library_id, show_path) ON DELETE CASCADE
);

isAutoScrapeSuppressed:
SELECT EXISTS(
    SELECT 1 FROM AutoScrapeSuppression
    WHERE library_id = :library_id AND show_path = :show_path
);

suppressAutoScrape:
INSERT OR REPLACE INTO AutoScrapeSuppression(library_id, show_path, suppressed_at)
VALUES (:library_id, :show_path, :suppressed_at);

unsuppressAutoScrape:
DELETE FROM AutoScrapeSuppression
WHERE library_id = :library_id AND show_path = :show_path;

-- 幂等 upsert(INSERT OR REPLACE; repository 先合并已有字段再写入):
-- 图片路径、远程 URL、episode thumbPath 以及本轮未提供的标量字段由 repository 保留，
-- 避免降级源或临时失败把持久在线 meta 清空。
upsertOnlineMeta:
INSERT OR REPLACE INTO ScrapedOnlineMeta(
    library_id, show_path, season_number, scrape_source, overwrite_title,
    tmdb_id, dandanplay_id, bangumi_id, remote_poster_url, local_poster_path, poster_source,
    title, original_title, year, plot, rating, release_date, genres, studios,
    episode_json, remote_fanart_url, local_fanart_path, scraped_at
) VALUES (
    :library_id, :show_path, :season_number, :scrape_source, :overwrite_title,
    :tmdb_id, :dandanplay_id, :bangumi_id, :remote_poster_url, :local_poster_path, :poster_source,
    :title, :original_title, :year, :plot, :rating, :release_date, :genres, :studios,
    :episode_json, :remote_fanart_url, :local_fanart_path, :scraped_at
);

getOnlineMeta:
SELECT * FROM ScrapedOnlineMeta
WHERE library_id = :library_id AND show_path = :show_path AND season_number = :season_number LIMIT 1;

listOnlineMetaByShow:
SELECT * FROM ScrapedOnlineMeta
WHERE library_id = :library_id AND show_path = :show_path AND season_number >= 0
ORDER BY season_number ASC;

-- 批量刮削 pending 复核用: 一次性取出候选番剧全部在线 meta(library_id 可空=全局),
-- 替代逐候选 listOnlineMetaByShow 的 N+1; 调用方按 (library_id, show_path) 分组。
listOnlineMetaByShowPaths:
SELECT * FROM ScrapedOnlineMeta
WHERE show_path IN :show_paths
  AND (:library_id IS NULL OR library_id = :library_id)
  AND season_number >= 0
ORDER BY library_id, show_path, season_number;

-- 自动未命中也写部级尝试时间，避免重新进入详情页立即重复 Bangumi/弹弹/hash 请求。
-- 已有成功或手动 meta 时只更新时间，不改变来源和业务字段。
insertAutoScrapeAttempt:
INSERT OR IGNORE INTO ScrapedOnlineMeta(
    library_id, show_path, season_number, scrape_source, overwrite_title, scraped_at
) VALUES (
    :library_id, :show_path, 0, 'AUTO_ATTEMPT', 0, :attempted_at
);

updateAutoScrapeAttemptAt:
UPDATE ScrapedOnlineMeta SET scraped_at = :attempted_at
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0;

deleteAutoScrapeAttempt:
DELETE FROM ScrapedOnlineMeta
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0
  AND scrape_source = 'AUTO_ATTEMPT';

upsertAutoScrapeRetryMarker:
INSERT OR REPLACE INTO ScrapedOnlineMeta(
    library_id, show_path, season_number, scrape_source, overwrite_title, scraped_at
) VALUES (
    :library_id, :show_path, -1, 'AUTO_ATTEMPT', 0, 0
);

deleteAutoScrapeRetryMarker:
DELETE FROM ScrapedOnlineMeta
WHERE library_id = :library_id AND show_path = :show_path AND season_number = -1;

hasAutoScrapeRetryMarker:
SELECT EXISTS(
    SELECT 1 FROM ScrapedOnlineMeta
    WHERE library_id = :library_id AND show_path = :show_path AND season_number = -1
);

-- 待刮番剧(海报墙批量/扫描后自动用): 部级尚未尝试，或部级/季级数据仍缺。
-- anchorOnly=true 仅按所属库 scan_mode=ANCHOR 过滤；anchorOnly=false 同时处理 NFO 缺项。
-- has_database_gap=1 可直接进入 pending；仅有本地在线缓存路径时交 repository 做真实文件存在性复核。
-- 过滤屏蔽; library_id 可空(全局)或限单库。
-- 冷却(cooldown_ms > 0 生效): 无重试标记(season_number=-1)且部级最近尝试(scraped_at)在冷却期内
--   的番剧跳过, 防止批量补刮反复重刮; 缓存缺失(has_database_gap=0 仅文件失效)不受冷却, 立即恢复。
-- 注意: poster 判定不再用 s.poster_path(NFO 媒体源字段, 在线刮削从不回填), 在线海报存在性由
--   ScrapedOnlineMeta 的季级条件与仓库层 hasInvalidOnlineImageCache 文件复核覆盖。
listScrapePending:
WITH candidates AS (
    SELECT s.library_id AS library_id, s.show_path AS show_path, s.id AS show_id,
           s.title AS title, s.tmdb_id AS tmdb_id,
           CASE WHEN
               NOT EXISTS (
                   SELECT 1 FROM ScrapedOnlineMeta m
                   WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
               )
               OR (:anchor_only = 0 AND (
                   (:require_tmdb_identity = 1 AND s.tmdb_id IS NULL)
                   OR s.plot IS NULL OR TRIM(s.plot) = ''
               ))
               OR EXISTS (
                   SELECT 1
                   FROM ScrapedSeason se
                   LEFT JOIN ScrapedOnlineMeta sm
                     ON sm.library_id = s.library_id
                    AND sm.show_path = s.show_path
                    AND sm.season_number = se.season_number
                   WHERE se.show_id = s.id
                     AND (
                         ((se.season_poster_path IS NULL OR TRIM(se.season_poster_path) = '')
                             AND (sm.local_poster_path IS NULL OR TRIM(sm.local_poster_path) = ''))
                         OR (
                             (sm.id IS NULL OR sm.episode_json IS NULL OR TRIM(sm.episode_json) = '')
                             AND EXISTS (
                                 SELECT 1 FROM ScrapedEpisode ep
                                 WHERE ep.season_id = se.id
                                   AND (
                                       ep.title IS NULL OR TRIM(ep.title) = ''
                                       OR ep.aired IS NULL OR TRIM(ep.aired) = ''
                                   )
                             )
                         )
                     )
               )
           THEN 1 ELSE 0 END AS has_database_gap,
           CASE WHEN EXISTS (
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path
                 AND (
                     NULLIF(TRIM(m.local_poster_path), '') IS NOT NULL
                     OR NULLIF(TRIM(m.local_fanart_path), '') IS NOT NULL
                     OR m.episode_json LIKE '%"thumbPath":%'
                 )
           ) THEN 1 ELSE 0 END AS has_local_cache_path,
           CASE WHEN EXISTS (
               SELECT 1 FROM ScrapedOnlineMeta m
               WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = -1
           ) THEN 1 ELSE 0 END AS has_retry_marker,
           (SELECT m.scraped_at FROM ScrapedOnlineMeta m
            WHERE m.library_id = s.library_id AND m.show_path = s.show_path AND m.season_number = 0
            LIMIT 1) AS last_attempt_at
    FROM ScrapedShow s
    INNER JOIN ScrapedLibrary l ON l.id = s.library_id
    LEFT JOIN ScrapedBlocked b ON b.library_id = s.library_id AND b.show_path = s.show_path
    WHERE b.id IS NULL
      AND (:library_id IS NULL OR s.library_id = :library_id)
      AND (:anchor_only = 0 OR l.scan_mode = 'ANCHOR')
)
SELECT library_id, show_path, show_id, title, tmdb_id, has_database_gap
FROM candidates
WHERE (has_database_gap = 1 OR has_local_cache_path = 1)
  AND (
      :cooldown_ms <= 0
      OR has_database_gap = 0
      OR has_retry_marker = 1
      OR last_attempt_at IS NULL
      OR last_attempt_at < :now_ms - :cooldown_ms
  );

deleteOnlineMetaByShow:
DELETE FROM ScrapedOnlineMeta WHERE library_id = :library_id AND show_path = :show_path;

deleteOnlineMetaByLibrary:
DELETE FROM ScrapedOnlineMeta WHERE library_id = :library_id;

-- 删库时清空全部在线 meta(保留 Library 配置)
deleteAllOnlineMeta:
DELETE FROM ScrapedOnlineMeta;

-- 最近一次部级刮削或自动尝试时间(懒触发节流用; 无记录返回 null)
lastOnlineMetaAt:
SELECT scraped_at FROM ScrapedOnlineMeta AS m
WHERE m.library_id = :library_id AND m.show_path = :show_path AND m.season_number = 0
  AND NOT EXISTS (
      SELECT 1 FROM ScrapedOnlineMeta AS retry
      WHERE retry.library_id = m.library_id AND retry.show_path = m.show_path
        AND retry.season_number = -1
  )
LIMIT 1;

-- ============ TMDB 增强写入(独立于主 upsert, 不参与 ON CONFLICT 覆盖) ============

-- 部级宽幅头图(TMDB backdrop): 写 remote URL + 本地绝对路径，UI 独立回退
updateOnlineMetaFanart:
UPDATE ScrapedOnlineMeta SET
    remote_fanart_url = COALESCE(:remote_fanart_url, remote_fanart_url),
    local_fanart_path = :local_fanart_path
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0;

-- 季级剧集剧照: 整体替换 episode_json；thumbPath 保持在线缓存来源，不写 local_thumb_path
updateOnlineMetaEpisodes:
UPDATE ScrapedOnlineMeta SET episode_json = :episode_json
WHERE library_id = :library_id AND show_path = :show_path AND season_number = :season_number;

-- TMDB still 查询成功后同时刷新季级检查时间，避免负缓存首次过期后退化为每日重试
updateOnlineMetaEpisodesAndScrapedAt:
UPDATE ScrapedOnlineMeta SET episode_json = :episode_json, scraped_at = :scraped_at
WHERE library_id = :library_id AND show_path = :show_path AND season_number = :season_number;

insertOnlineMetaTmdbId:
INSERT OR IGNORE INTO ScrapedOnlineMeta(
    library_id, show_path, season_number, scrape_source, overwrite_title, tmdb_id, scraped_at
) VALUES (
    :library_id, :show_path, 0, :scrape_source, 0, :tmdb_id, :scraped_at
);

updateOnlineMetaTmdbId:
UPDATE ScrapedOnlineMeta SET tmdb_id = :tmdb_id
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0;

markOnlineMetaTmdbSource:
UPDATE ScrapedOnlineMeta SET scrape_source = :scrape_source
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0
  AND (scrape_source = 'AUTO_ATTEMPT' OR :scrape_source = 'MANUAL_TMDB');

updateShowTmdbId:
UPDATE ScrapedShow SET tmdb_id = :tmdb_id
WHERE library_id = :library_id AND show_path = :show_path;

clearOnlineMetaTmdbEnrichment:
UPDATE ScrapedOnlineMeta SET
    tmdb_id = NULL,
    remote_fanart_url = NULL,
    local_fanart_path = NULL
WHERE library_id = :library_id AND show_path = :show_path AND season_number = 0;

clearOnlineMetaImageCache:
UPDATE ScrapedOnlineMeta SET
    local_poster_path = NULL,
    local_fanart_path = NULL
WHERE library_id = :library_id AND show_path = :show_path;

clearShowEpisodeLocalThumbs:
UPDATE ScrapedEpisode SET local_thumb_path = NULL
WHERE show_id = :show_id;

clearShowTmdbId:
UPDATE ScrapedShow SET tmdb_id = NULL
WHERE library_id = :library_id AND show_path = :show_path;

-- ============ 在线刮削 meta 重放(reapply)用 SQL ============
-- 文本覆盖语义(fill-if-null / manual 覆盖)在 repository 层决定；图片字段只用于清理旧版污染值。

updateShowOnlineMeta:
UPDATE ScrapedShow SET
    tmdb_id = :tmdb_id, title = :title, original_title = :original_title, year = :year, plot = :plot,
    rating = :rating, release_date = :release_date, genres = :genres, studios = :studios,
    fanart_path = :fanart_path
WHERE id = :id;

updateSeasonPoster:
UPDATE ScrapedSeason SET season_poster_path = :season_poster_path WHERE id = :id;

updateEpisodeOnlineMeta:
UPDATE ScrapedEpisode SET
    title = :title, aired = :aired, plot = :plot, local_thumb_path = :local_thumb_path
WHERE id = :id;

getEpisodeBySeasonAndNumber:
SELECT * FROM ScrapedEpisode WHERE season_id = :season_id AND episode_number = :episode_number LIMIT 1;

-- ============ 媒体库导出/导入 ============
-- 设计见 .claude/plans(媒体库导出/导入)。导出读整库数据, 导入裸插重建(绕过 upsertOnlineMeta merge 语义)。

-- 导出: 整库在线 meta(season_number >= 0 业务行, 排除 -1 重试标记)
listOnlineMetaByLibrary:
SELECT * FROM ScrapedOnlineMeta
WHERE library_id = :library_id AND season_number >= 0
ORDER BY show_path, season_number;

-- 导出: 整库 Bangumi 季度关联(show 前缀按库过滤 + tmdb-tv 前缀全表收集, 导出端按本库引用再过滤)
listBangumiSeasonLinksByLibrary:
SELECT * FROM BangumiSeasonLinkEntity
WHERE identity_key LIKE 'show:' || CAST(:library_id AS TEXT) || ':%'
   OR identity_key LIKE 'tmdb-tv:%'
ORDER BY identity_key;

-- 导出: 整库本部覆盖(show 前缀按库过滤 + tmdb 前缀全表收集)
listShowOverrideByLibrary:
SELECT * FROM ShowSettingsOverride
WHERE identity_key LIKE 'show:' || CAST(:library_id AS TEXT) || ':%'
   OR identity_key LIKE 'tmdb:%'
ORDER BY identity_key;

-- 导入: 裸写在线 meta(全字段, 无 merge 语义; INSERT OR REPLACE 幂等)。
-- poster_source: 优先用导出值; 旧包/缺省时按海报对是否非空回退到 scrape_source, 保证导入后优先级保护不丢。
insertOnlineMetaRaw:
INSERT OR REPLACE INTO ScrapedOnlineMeta(
    library_id, show_path, season_number, scrape_source, overwrite_title,
    tmdb_id, dandanplay_id, bangumi_id, remote_poster_url, local_poster_path, poster_source,
    title, original_title, year, plot, rating, release_date, genres, studios,
    episode_json, remote_fanart_url, local_fanart_path, scraped_at
) VALUES (
    :library_id, :show_path, :season_number, :scrape_source, :overwrite_title,
    :tmdb_id, :dandanplay_id, :bangumi_id, :remote_poster_url, :local_poster_path,
    CASE
        WHEN :poster_source IS NOT NULL AND TRIM(:poster_source) != '' THEN :poster_source
        WHEN NULLIF(TRIM(:remote_poster_url), '') IS NOT NULL
          OR NULLIF(TRIM(:local_poster_path), '') IS NOT NULL THEN :scrape_source
        ELSE NULL
    END,
    :title, :original_title, :year, :plot, :rating, :release_date, :genres, :studios,
    :episode_json, :remote_fanart_url, :local_fanart_path, :scraped_at
);

-- 导入: 清库数据(覆盖重建前清空; 屏蔽/覆盖/关联/失败标记按库清理)
deleteBlockedByLibrary:
DELETE FROM ScrapedBlocked WHERE library_id = :library_id;

deleteShowOverrideByLibrary:
DELETE FROM ShowSettingsOverride WHERE identity_key LIKE 'show:' || CAST(:library_id AS TEXT) || ':%';

deleteBangumiSeasonLinkByLibrary:
DELETE FROM BangumiSeasonLinkEntity WHERE identity_key LIKE 'show:' || CAST(:library_id AS TEXT) || ':%';

deleteTmdbAutoMatchFailuresByLibrary:
DELETE FROM TmdbAutoMatchFailure WHERE library_id = :library_id;

-- 导入图片还原后回写季照本地路径
updateOnlineMetaLocalPoster:
UPDATE ScrapedOnlineMeta SET local_poster_path = :local_poster_path
WHERE library_id = :library_id AND show_path = :show_path AND season_number = :season_number;
