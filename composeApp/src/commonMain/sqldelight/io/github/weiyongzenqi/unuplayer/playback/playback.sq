-- 播放记录表(本期本地, 预留 sync 字段供未来跨设备同步)
-- 表名 PascalCase 让 SQLDelight 生成 PascalCase 类名; 列名保留下划线(SQL 惯例)
-- media_key 唯一标识: WebDAV=url, 本地=contentUri 优先 fallback fileHash
CREATE TABLE PlaybackRecord (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    media_key TEXT NOT NULL UNIQUE,
    source_kind TEXT NOT NULL,
    url TEXT NOT NULL,
    content_uri TEXT,
    title TEXT NOT NULL,
    position_ms INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    watch_progress REAL NOT NULL DEFAULT 0.0,
    is_completed INTEGER NOT NULL DEFAULT 0,
    -- 三元组(tmdbId+季+集): tmdbId 刮削番剧的跨刮削库续播锚点标注。唯一性与进度走 EpisodeProgress 表,
    -- 此处不加唯一索引(否则与 upsertInsertIfAbsent 的 INSERT OR IGNORE 冲突时静默吞行丢进度)。
    tmdb_id INTEGER,
    season_number INTEGER,
    episode_number INTEGER,
    danmaku_episode_id INTEGER,
    danmaku_anime_id INTEGER,
    danmaku_anime_title TEXT,
    danmaku_episode_title TEXT,
    danmaku_match_method TEXT,
    -- 弹幕匹配独立逻辑时钟；不能与播放进度 sync_version 共用，否则两个维度互相覆盖。
    danmaku_sync_version INTEGER NOT NULL DEFAULT 0,
    danmaku_updated_at INTEGER NOT NULL DEFAULT 0,
    last_played_at INTEGER NOT NULL,
    -- 预留同步字段(本期不用, 默认 0)
    sync_status INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0
);

-- 三元组语义进度表(跨刮削库续播锚点): 同一 (tmdb_id, season_number, episode_number) 跨不同刮削库/文件共享一份进度。
-- 独立表 + 三元组主键(而非 PlaybackRecord 加部分唯一索引): 后者会被 upsertInsertIfAbsent 的 INSERT OR IGNORE
-- 在 media_key 不同但三元组相同时静默吞行, 丢失新文件物理进度行。media_key 记最近一次播放该三元组的文件,
-- 供 updatePosition/finishPlayback/deleteByKey 按 media_key 级联(无需三元组)。
CREATE TABLE EpisodeProgress (
    tmdb_id INTEGER NOT NULL,
    season_number INTEGER NOT NULL,
    episode_number INTEGER NOT NULL,
    media_key TEXT,
    position_ms INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    watch_progress REAL NOT NULL DEFAULT 0.0,
    is_completed INTEGER NOT NULL DEFAULT 0,
    last_played_at INTEGER NOT NULL,
    sync_status INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (tmdb_id, season_number, episode_number)
);
CREATE INDEX idx_episode_progress_media_key ON EpisodeProgress(media_key);

-- 单条删除事件必须跨设备持久化。没有每设备 ack/vector 前不做 TTL/条数 GC，避免长期离线设备复活旧记录。
CREATE TABLE PlaybackRecordTombstone (
    media_key TEXT NOT NULL PRIMARY KEY,
    media_identity TEXT,
    deleted_at INTEGER NOT NULL,
    sync_version INTEGER NOT NULL
);

CREATE TABLE EpisodeProgressTombstone (
    tmdb_id INTEGER NOT NULL,
    season_number INTEGER NOT NULL,
    episode_number INTEGER NOT NULL,
    media_key TEXT,
    media_identity TEXT,
    deleted_at INTEGER NOT NULL,
    sync_version INTEGER NOT NULL,
    PRIMARY KEY (tmdb_id, season_number, episode_number)
);

-- clear-all 不能只为本机可见行造 tombstone；epoch 递增后所有低 epoch 离线快照整体失效。
CREATE TABLE PlaybackSyncState (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    history_epoch INTEGER NOT NULL DEFAULT 0
);
INSERT OR IGNORE INTO PlaybackSyncState(singleton_id, history_epoch) VALUES (1, 0);

CREATE INDEX idx_last_played ON PlaybackRecord(last_played_at DESC);
CREATE INDEX idx_anime_id ON PlaybackRecord(danmaku_anime_id);

getByMediaKey:
SELECT * FROM PlaybackRecord WHERE media_key = :media_key LIMIT 1;

-- 播放记录同步与时间表标记共用一次数据库事务；这些查询只用于远端合并，
-- 本地标记写入仍由 scraped.sq 在事务内递增逻辑版本。
getSyncScheduleWatch:
SELECT subject_id, title, air_weekday, anime_id, tmdb_id, watched_at, status, sync_version
FROM ScheduleWatch WHERE subject_id = :subject_id;

getSyncScheduleWatchTombstone:
SELECT subject_id, deleted_at, sync_version
FROM ScheduleWatchTombstone WHERE subject_id = :subject_id;

upsertSyncScheduleWatch:
INSERT OR REPLACE INTO ScheduleWatch(subject_id, title, air_weekday, anime_id, tmdb_id, watched_at, status, sync_version)
VALUES (:subject_id, :title, :air_weekday, :anime_id, :tmdb_id, :watched_at, :status, :sync_version);

deleteSyncScheduleWatch:
DELETE FROM ScheduleWatch WHERE subject_id = :subject_id;

upsertSyncScheduleWatchTombstone:
INSERT OR REPLACE INTO ScheduleWatchTombstone(subject_id, deleted_at, sync_version)
VALUES (:subject_id, :deleted_at, :sync_version);

deleteSyncScheduleWatchTombstone:
DELETE FROM ScheduleWatchTombstone WHERE subject_id = :subject_id;

-- 批量查(浏览列表"已播放进度"披露式查询用): 一次查当前目录所有文件的记录
getByMediaKeys:
SELECT * FROM PlaybackRecord WHERE media_key IN :media_keys;

listPage:
SELECT * FROM PlaybackRecord ORDER BY last_played_at DESC LIMIT :limit OFFSET :offset;

-- P3㉓: 原 upsert 是 INSERT OR REPLACE(整行删旧插新), 冲突时 AUTOINCREMENT id 抖动,
-- 以 id 为键的外部引用失效。改为逐字段 UPDATE 保持 id 稳定。
-- 不用 ON CONFLICT(media_key) DO UPDATE: 该语法需 SQLite 3.24+, 而 minSdk 26 的系统 SQLite
-- 为 3.18(API 27=3.19 / API 28=3.22, 见 android.database.sqlite 官方版本表), Android 8.x/9
-- 会语法错误崩溃(项目已用 AndroidSqliteDriver=系统库; 同 scraped.sq 规避 NULLS LAST 先例)。
-- 故拆为两条全版本兼容语句, 由仓库实现在同一事务内组合(先 update 后 insert):
--   记录不存在   → upsertUpdateIfNewer 打 0 行, upsertInsertIfAbsent 插新行;
--   存在且更旧   → upsertUpdateIfNewer 逐字段更新(id 不变), upsertInsertIfAbsent 撞 UNIQUE(media_key) 被 IGNORE;
--   存在且更新/等 → upsertUpdateIfNewer 守卫不命中, upsertInsertIfAbsent 撞 UNIQUE 被 IGNORE(单调守卫, 与原 NOT EXISTS 语义一致)。
upsertUpdateIfNewer:
UPDATE PlaybackRecord
SET source_kind = :source_kind,
    url = :url,
    content_uri = :content_uri,
    title = :title,
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    tmdb_id = COALESCE(:tmdb_id, tmdb_id),
    season_number = COALESCE(:season_number, season_number),
    episode_number = COALESCE(:episode_number, episode_number),
    -- CR-064: 弹幕字段用 COALESCE(:new, 旧值) 防止 upsert 用陈旧 existing(null 弹幕)覆盖
    -- updateDanmaku 刚写入的非 null 匹配信息。仅防 null 覆盖非 null, 不防旧值覆盖新值
    -- (后者由仓库内 Mutex/runSerialized 串行化保证调用顺序解决)。两端共享, Android 走
    -- runSerialized 串行化, COALESCE 对其语义无回退(同 existing 读自 DB, COALESCE 取相同值)。
    danmaku_episode_id = CASE WHEN :danmaku_sync_version > danmaku_sync_version
        OR (danmaku_sync_version = 0 AND danmaku_episode_id IS NULL)
        THEN COALESCE(:danmaku_episode_id, danmaku_episode_id) ELSE danmaku_episode_id END,
    danmaku_anime_id = CASE WHEN :danmaku_sync_version > danmaku_sync_version
        OR (danmaku_sync_version = 0 AND danmaku_anime_id IS NULL)
        THEN COALESCE(:danmaku_anime_id, danmaku_anime_id) ELSE danmaku_anime_id END,
    danmaku_anime_title = CASE WHEN :danmaku_sync_version > danmaku_sync_version
        OR (danmaku_sync_version = 0 AND danmaku_anime_title IS NULL)
        THEN COALESCE(:danmaku_anime_title, danmaku_anime_title) ELSE danmaku_anime_title END,
    danmaku_episode_title = CASE WHEN :danmaku_sync_version > danmaku_sync_version
        OR (danmaku_sync_version = 0 AND danmaku_episode_title IS NULL)
        THEN COALESCE(:danmaku_episode_title, danmaku_episode_title) ELSE danmaku_episode_title END,
    danmaku_match_method = CASE WHEN :danmaku_sync_version > danmaku_sync_version
        OR (danmaku_sync_version = 0 AND danmaku_match_method IS NULL)
        THEN COALESCE(:danmaku_match_method, danmaku_match_method) ELSE danmaku_match_method END,
    danmaku_sync_version = MAX(danmaku_sync_version, :danmaku_sync_version),
    danmaku_updated_at = MAX(danmaku_updated_at, :danmaku_updated_at),
    last_played_at = :last_played_at,
    sync_status = :sync_status,
    sync_version = :sync_version
WHERE media_key = :media_key AND last_played_at < :last_played_at;

-- upsert 的插入分支: media_key 不存在时插新行; 已存在则 UNIQUE 冲突被 IGNORE(不覆盖)。
upsertInsertIfAbsent:
INSERT OR IGNORE INTO PlaybackRecord(
    media_key, source_kind, url, content_uri, title,
    position_ms, duration_ms, watch_progress, is_completed,
    tmdb_id, season_number, episode_number,
    danmaku_episode_id, danmaku_anime_id, danmaku_anime_title, danmaku_episode_title, danmaku_match_method,
    danmaku_sync_version, danmaku_updated_at,
    last_played_at, sync_status, sync_version
) VALUES (
    :media_key, :source_kind, :url, :content_uri, :title,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :tmdb_id, :season_number, :episode_number,
    :danmaku_episode_id, :danmaku_anime_id, :danmaku_anime_title, :danmaku_episode_title, :danmaku_match_method,
    :danmaku_sync_version, :danmaku_updated_at,
    :last_played_at, :sync_status,
    MAX(:sync_version, COALESCE((SELECT sync_version FROM PlaybackRecordTombstone WHERE media_key = :media_key), -1) + 1)
);

-- B-1: 播放入口专用 upsert。sync_version 由 SQL 在写时原子 +1(基于行内当前版本),
-- 消除调用方"快照读 -> 内存 v+1 -> upsert"在事务外的 Lamport 回退窗口(读与写之间
-- pull 合并高版本时, 旧快照 v+1 会把高版本回退, 远端旧进度在下次同步胜出覆盖本地)。
-- update 守卫命中时 +1; insert 分支用子查询取当前行版本 +1(行不存在从 0 起步)。
-- sync_status 透传调用方值(与原 upsert 一致)。事务组合同 upsert(先 update 后 insert)。
upsertEntryUpdateIfNewer:
UPDATE PlaybackRecord
SET source_kind = :source_kind,
    url = :url,
    content_uri = :content_uri,
    title = :title,
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    tmdb_id = COALESCE(:tmdb_id, tmdb_id),
    season_number = COALESCE(:season_number, season_number),
    episode_number = COALESCE(:episode_number, episode_number),
    last_played_at = :last_played_at,
    sync_status = :sync_status,
    sync_version = MAX(
        sync_version,
        COALESCE((SELECT sync_version FROM PlaybackRecordTombstone WHERE media_key = :media_key), 0)
    ) + 1
WHERE media_key = :media_key AND last_played_at < :last_played_at;

upsertEntryInsertIfAbsent:
INSERT OR IGNORE INTO PlaybackRecord(
    media_key, source_kind, url, content_uri, title,
    position_ms, duration_ms, watch_progress, is_completed,
    tmdb_id, season_number, episode_number,
    danmaku_episode_id, danmaku_anime_id, danmaku_anime_title, danmaku_episode_title, danmaku_match_method,
    danmaku_sync_version, danmaku_updated_at,
    last_played_at, sync_status, sync_version
) VALUES (
    :media_key, :source_kind, :url, :content_uri, :title,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :tmdb_id, :season_number, :episode_number,
    :danmaku_episode_id, :danmaku_anime_id, :danmaku_anime_title, :danmaku_episode_title, :danmaku_match_method,
    :danmaku_sync_version, :danmaku_updated_at,
    :last_played_at, :sync_status,
    MAX(
        COALESCE((SELECT sync_version FROM PlaybackRecord WHERE media_key = :media_key), 0),
        COALESCE((SELECT sync_version FROM PlaybackRecordTombstone WHERE media_key = :media_key), 0)
    ) + 1
);

updatePosition:
UPDATE PlaybackRecord
SET position_ms = :position_ms, watch_progress = :watch_progress, last_played_at = :last_played_at
WHERE media_key = :media_key AND last_played_at < :last_played_at;

updateDanmaku:
UPDATE PlaybackRecord
SET danmaku_episode_id = :danmaku_episode_id,
    danmaku_anime_id = :danmaku_anime_id,
    danmaku_anime_title = :danmaku_anime_title,
    danmaku_episode_title = :danmaku_episode_title,
    danmaku_match_method = :danmaku_match_method,
    danmaku_sync_version = MAX(
        danmaku_sync_version,
        COALESCE((SELECT sync_version FROM PlaybackRecordTombstone WHERE media_key = :media_key), 0)
    ) + 1,
    danmaku_updated_at = :danmaku_updated_at
WHERE media_key = :media_key;

-- 退出播放时存: 仅更新位置/时长/进度/完成态/时间, 不碰弹幕匹配字段(避免覆盖 3c 存的匹配信息)。
-- 记录不存在时 no-op(节流尚未建记录就退出 = 秒退, 不存)。
finishPlayback:
UPDATE PlaybackRecord
SET position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    last_played_at = :last_played_at
WHERE media_key = :media_key
  AND last_played_at < :last_played_at
  AND (position_ms <= 0 OR :position_ms > 0);

deleteByKey:
DELETE FROM PlaybackRecord WHERE media_key = :media_key;

deleteAll:
DELETE FROM PlaybackRecord;

count:
SELECT COUNT(*) FROM PlaybackRecord;

-- === EpisodeProgress(三元组语义进度)===
-- 同 PlaybackRecord 两阶段 upsert + 单调守卫, 全版本兼容(无 ON CONFLICT DO UPDATE)。
episodeProgressUpsertUpdateIfNewer:
UPDATE EpisodeProgress
SET media_key = :media_key,
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    last_played_at = :last_played_at,
    sync_status = :sync_status,
    sync_version = :sync_version
WHERE tmdb_id = :tmdb_id
  AND season_number = :season_number
  AND episode_number = :episode_number
  AND last_played_at < :last_played_at;

episodeProgressUpsertInsertIfAbsent:
INSERT OR IGNORE INTO EpisodeProgress(
    tmdb_id, season_number, episode_number, media_key,
    position_ms, duration_ms, watch_progress, is_completed,
    last_played_at, sync_status, sync_version
) VALUES (
    :tmdb_id, :season_number, :episode_number, :media_key,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :last_played_at, :sync_status, :sync_version
);

-- 播放入口的三元组写入必须基于 EpisodeProgress 自身版本递增，不能复制当前 media_key 主行版本。
-- 同一集切换到从未播放的新文件时，主行会从 1 起步，但三元组可能已被同步合并到更高版本。
episodeProgressUpsertEntryUpdateIfNewer:
UPDATE EpisodeProgress
SET media_key = :media_key,
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    last_played_at = :last_played_at,
    sync_status = :sync_status,
    sync_version = MAX(
        sync_version,
        COALESCE((
            SELECT sync_version FROM EpisodeProgressTombstone
            WHERE tmdb_id = :tmdb_id
              AND season_number = :season_number
              AND episode_number = :episode_number
        ), 0)
    ) + 1
WHERE tmdb_id = :tmdb_id
  AND season_number = :season_number
  AND episode_number = :episode_number
  AND last_played_at < :last_played_at;

episodeProgressUpsertEntryInsertIfAbsent:
INSERT OR IGNORE INTO EpisodeProgress(
    tmdb_id, season_number, episode_number, media_key,
    position_ms, duration_ms, watch_progress, is_completed,
    last_played_at, sync_status, sync_version
) VALUES (
    :tmdb_id, :season_number, :episode_number, :media_key,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :last_played_at, :sync_status,
    MAX(
        COALESCE((
            SELECT sync_version FROM EpisodeProgress
            WHERE tmdb_id = :tmdb_id
              AND season_number = :season_number
              AND episode_number = :episode_number
        ), 0),
        COALESCE((
            SELECT sync_version FROM EpisodeProgressTombstone
            WHERE tmdb_id = :tmdb_id
              AND season_number = :season_number
              AND episode_number = :episode_number
        ), 0)
    ) + 1
);

episodeProgressGetByTriple:
SELECT * FROM EpisodeProgress
WHERE tmdb_id = :tmdb_id
  AND season_number = :season_number
  AND episode_number = :episode_number
LIMIT 1;

-- 批量按三元组查(详情页剧集进度条补齐用): IN 批量(调用方分块 ≤500)。三元组三列拼串做 key 便于 Kotlin 侧建 "tmdb-season-episode" -> 行 映射。
episodeProgressGetByTriples:
SELECT * FROM EpisodeProgress
WHERE tmdb_id || '-' || season_number || '-' || episode_number IN :triple_keys;

-- 按 media_key 级联(节流/退出/删除), 无需三元组(EpisodeProgress.media_key 已关联)。
episodeProgressUpdatePosition:
UPDATE EpisodeProgress
SET position_ms = :position_ms, watch_progress = :watch_progress, last_played_at = :last_played_at
WHERE media_key = :media_key AND last_played_at < :last_played_at;

episodeProgressFinish:
UPDATE EpisodeProgress
SET position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    last_played_at = :last_played_at
WHERE media_key = :media_key
  AND last_played_at < :last_played_at
  AND (position_ms <= 0 OR :position_ms > 0);

episodeProgressDeleteByMediaKey:
DELETE FROM EpisodeProgress WHERE media_key = :media_key;

episodeProgressDeleteByTriple:
DELETE FROM EpisodeProgress
WHERE tmdb_id = :tmdb_id
  AND season_number = :season_number
  AND episode_number = :episode_number;

-- 清空所有语义进度(deleteAll 联动, 与 PlaybackRecord deleteAll 同事务语义)
episodeProgressDeleteAll:
DELETE FROM EpisodeProgress;

episodeProgressListByMediaKey:
SELECT * FROM EpisodeProgress WHERE media_key = :media_key;

-- === P2 同步查询 ===
-- 全量读(push/pull 用)
listAll:
SELECT * FROM PlaybackRecord;

episodeProgressListAll:
SELECT * FROM EpisodeProgress;

-- P2 同步: 合并专用 force upsert(无 last_played_at 守卫; Coordinator 已决策胜出方)。
-- 与 upsertUpdateIfNewer 同步字段一致, 但去掉 WHERE last_played_at < 守卫, 按 media_key 直接覆盖。
-- url: 合并写入时调用方已按当前连接重算(WebDAV 重算 / 导入重映射), 更新已存在行也须写 url,
--   否则重算的 URL 被静默丢弃, 历史重播仍指向旧服务器/旧账号。id 自增保留。sync_status 置 0(合并写入即已同步)。
upsertSyncForceUpdate:
UPDATE PlaybackRecord
SET source_kind = :source_kind,
    url = :url,
    title = :title,
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    tmdb_id = COALESCE(:tmdb_id, tmdb_id),
    season_number = COALESCE(:season_number, season_number),
    episode_number = COALESCE(:episode_number, episode_number),
    danmaku_episode_id = :danmaku_episode_id,
    danmaku_anime_id = :danmaku_anime_id,
    danmaku_anime_title = :danmaku_anime_title,
    danmaku_episode_title = :danmaku_episode_title,
    danmaku_match_method = :danmaku_match_method,
    danmaku_sync_version = :danmaku_sync_version,
    danmaku_updated_at = :danmaku_updated_at,
    last_played_at = :last_played_at,
    sync_status = 0,
    sync_version = :sync_version
WHERE media_key = :media_key;

-- 插入分支: 本地不存在该 media_key 时插新行。url 用 :url(调用方传 media_key, 因 WebDAV media_key=url);
-- content_uri 传 NULL(DTO 不含, 本地专有); sync_status=0; id 自增忽略。
upsertSyncInsertIfAbsent:
INSERT OR IGNORE INTO PlaybackRecord(
    media_key, source_kind, url, content_uri, title,
    position_ms, duration_ms, watch_progress, is_completed,
    tmdb_id, season_number, episode_number,
    danmaku_episode_id, danmaku_anime_id, danmaku_anime_title, danmaku_episode_title, danmaku_match_method,
    danmaku_sync_version, danmaku_updated_at,
    last_played_at, sync_status, sync_version
) VALUES (
    :media_key, :source_kind, :url, NULL, :title,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :tmdb_id, :season_number, :episode_number,
    :danmaku_episode_id, :danmaku_anime_id, :danmaku_anime_title, :danmaku_episode_title, :danmaku_match_method,
    :danmaku_sync_version, :danmaku_updated_at,
    :last_played_at, 0, :sync_version
);

episodeProgressSyncForceUpdate:
UPDATE EpisodeProgress
SET media_key = COALESCE(:media_key, media_key),
    position_ms = :position_ms,
    duration_ms = :duration_ms,
    watch_progress = :watch_progress,
    is_completed = :is_completed,
    last_played_at = :last_played_at,
    sync_status = 0,
    sync_version = :sync_version
WHERE tmdb_id = :tmdb_id AND season_number = :season_number AND episode_number = :episode_number;

episodeProgressSyncInsertIfAbsent:
INSERT OR IGNORE INTO EpisodeProgress(
    tmdb_id, season_number, episode_number, media_key,
    position_ms, duration_ms, watch_progress, is_completed,
    last_played_at, sync_status, sync_version
) VALUES (
    :tmdb_id, :season_number, :episode_number, :media_key,
    :position_ms, :duration_ms, :watch_progress, :is_completed,
    :last_played_at, 0, :sync_version
);

-- === 同步删除事件 / history epoch ===
getPlaybackRecordTombstone:
SELECT * FROM PlaybackRecordTombstone WHERE media_key = :media_key LIMIT 1;

listPlaybackRecordTombstones:
SELECT * FROM PlaybackRecordTombstone;

upsertPlaybackRecordTombstone:
INSERT OR REPLACE INTO PlaybackRecordTombstone(media_key, media_identity, deleted_at, sync_version)
VALUES (:media_key, :media_identity, :deleted_at, :sync_version);

deletePlaybackRecordTombstone:
DELETE FROM PlaybackRecordTombstone WHERE media_key = :media_key;

deleteAllPlaybackRecordTombstones:
DELETE FROM PlaybackRecordTombstone;

getEpisodeProgressTombstone:
SELECT * FROM EpisodeProgressTombstone
WHERE tmdb_id = :tmdb_id AND season_number = :season_number AND episode_number = :episode_number
LIMIT 1;

listEpisodeProgressTombstones:
SELECT * FROM EpisodeProgressTombstone;

upsertEpisodeProgressTombstone:
INSERT OR REPLACE INTO EpisodeProgressTombstone(
    tmdb_id, season_number, episode_number, media_key, media_identity, deleted_at, sync_version
) VALUES (
    :tmdb_id, :season_number, :episode_number, :media_key, :media_identity, :deleted_at, :sync_version
);

deleteEpisodeProgressTombstone:
DELETE FROM EpisodeProgressTombstone
WHERE tmdb_id = :tmdb_id AND season_number = :season_number AND episode_number = :episode_number;

deleteAllEpisodeProgressTombstones:
DELETE FROM EpisodeProgressTombstone;

getPlaybackHistoryEpoch:
SELECT history_epoch FROM PlaybackSyncState WHERE singleton_id = 1;

setPlaybackHistoryEpoch:
UPDATE PlaybackSyncState SET history_epoch = :history_epoch WHERE singleton_id = 1;

incrementPlaybackHistoryEpoch:
UPDATE PlaybackSyncState SET history_epoch = history_epoch + 1 WHERE singleton_id = 1;
